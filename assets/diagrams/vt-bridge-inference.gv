// Graphviz source generated by tools/render_method_diagrams.py
digraph VTBridge {
  graph [rankdir=LR, bgcolor="white", pad="0.15", nodesep="0.30", ranksep="0.33", splines=polyline, fontname="Helvetica", fontsize=16, compound=true];
  node [fontname="Helvetica", fontsize=15, fontcolor="#253344", color="#67788b", penwidth=1.25, margin="0.12,0.10"];
  edge [color="#64758a", penwidth=1.5, arrowsize=0.65, fontname="Helvetica", fontsize=12, fontcolor="#405267"];
  obs [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD>Observation <FONT FACE="Times New Roman"><I>o</I></FONT></TD></TR><TR><TD>Instruction <FONT FACE="Times New Roman"><I>l</I></FONT></TD></TR></TABLE>>];
  vla [shape=box3d, style=filled, fillcolor="#e8edf3", label=<<B>Pretrained VLA</B><BR/><FONT FACE="Times New Roman" POINT-SIZE="22">π<SUP>VLA</SUP></FONT><BR/><FONT POINT-SIZE="12">Fine-tuned backbone</FONT>>];
  chunk [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD><B>Action chunk A</B></TD></TR>
      <TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="3"><TR><TD WIDTH="29" HEIGHT="27" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"><FONT FACE="Times New Roman" POINT-SIZE="15">a<SUB>1</SUB></FONT></TD><TD WIDTH="29" HEIGHT="27" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"><FONT FACE="Times New Roman" POINT-SIZE="15">a<SUB>2</SUB></FONT></TD><TD WIDTH="29" HEIGHT="27" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"><FONT FACE="Times New Roman" POINT-SIZE="15">…</FONT></TD><TD WIDTH="29" HEIGHT="27" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"><FONT FACE="Times New Roman" POINT-SIZE="15">a<SUB>H</SUB></FONT></TD></TR></TABLE></TD></TR>
      <TR><TD><FONT POINT-SIZE="12" COLOR="#596574">H = 50</FONT></TD></TR></TABLE>>];
  force [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD><B>Force window F</B></TD></TR>
      <TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="3"><TR><TD WIDTH="29" HEIGHT="27" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#b38251"><FONT FACE="Times New Roman" POINT-SIZE="15">f<SUB>t−n+1</SUB></FONT></TD><TD WIDTH="29" HEIGHT="27" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#b38251"><FONT FACE="Times New Roman" POINT-SIZE="15">…</FONT></TD><TD WIDTH="29" HEIGHT="27" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#b38251"><FONT FACE="Times New Roman" POINT-SIZE="15">f<SUB>t</SUB></FONT></TD></TR></TABLE></TD></TR>
      <TR><TD><FONT POINT-SIZE="12" COLOR="#596574">n = 50</FONT></TD></TR></TABLE>>];
  subgraph cluster_adapter {
    label=<<B>Residual adapter</B> <FONT FACE="Times New Roman">π<SUP>res</SUP></FONT><BR/><FONT POINT-SIZE="12">0.98M parameters · backbone-specific</FONT>>;
    labelloc=t; labeljust=l; color="#b8c4d0"; style="rounded,dashed"; penwidth=1.2; margin=18;
    action_encoder [shape=box3d, style=filled, fillcolor="#cddff3", color="#527caa", label=<<B>Transformer</B><BR/>Action encoder<BR/><FONT POINT-SIZE="11">Once per chunk</FONT>>];
    force_encoder [shape=box3d, style=filled, fillcolor="#f4dcc2", color="#b38251", label=<<B>Transformer</B><BR/>Force encoder<BR/><FONT POINT-SIZE="11">Each execution step</FONT>>];
    za [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD><FONT FACE="Times New Roman" POINT-SIZE="18">z<SUP>a</SUP></FONT></TD></TR>
      <TR><TD PORT="vec"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD WIDTH="11" HEIGHT="32" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#cddff3" BORDER="1" COLOR="#527caa"></TD></TR></TABLE></TD></TR>
      <TR><TD><FONT POINT-SIZE="11" COLOR="#596574">cached</FONT></TD></TR></TABLE>>];
    zf [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD><FONT FACE="Times New Roman" POINT-SIZE="18">z<SUB>t</SUB><SUP>f</SUP></FONT></TD></TR>
      <TR><TD PORT="vec"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD WIDTH="11" HEIGHT="32" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#b38251"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#b38251"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#b38251"></TD></TR></TABLE></TD></TR>
      <TR><TD><FONT POINT-SIZE="11" COLOR="#596574">updated</FONT></TD></TR></TABLE>>];
    fusion [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD><FONT FACE="Times New Roman" POINT-SIZE="18">[zᵃ ; zᶠₜ]</FONT></TD></TR>
      <TR><TD PORT="vec"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="0"><TR><TD WIDTH="11" HEIGHT="32" BGCOLOR="#cddff3" BORDER="1" COLOR="#8490a0"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#cddff3" BORDER="1" COLOR="#8490a0"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#cddff3" BORDER="1" COLOR="#8490a0"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#8490a0"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#8490a0"></TD><TD WIDTH="11" HEIGHT="32" BGCOLOR="#f4dcc2" BORDER="1" COLOR="#8490a0"></TD></TR></TABLE></TD></TR>
      <TR><TD><FONT POINT-SIZE="11" COLOR="#596574">Concatenate</FONT></TD></TR></TABLE>>];
    mlp [shape=trapezium, orientation=90, style=filled, fillcolor="#ded9ee", color="#897da6", label=<<B>MLP</B><BR/><FONT POINT-SIZE="12">Residual<BR/>head</FONT>>];
    action_encoder:e -> za:w [color="#527caa"];
    force_encoder:e -> zf:w [color="#b38251"];
    za:e -> fusion:w [color="#527caa"];
    zf:e -> fusion:w [color="#b38251"];
    fusion:e -> mlp:w;
    {rank=same; action_encoder; force_encoder;}
    {rank=same; za; zf;}
  }
  residual [shape=plain, label=<<FONT FACE="Times New Roman" POINT-SIZE="20">a<SUB>t</SUB><SUP>res</SUP></FONT>>];
  add [shape=circle, fixedsize=true, width=0.40, fontsize=22, label="+", margin=0];
  output [shape=plain, label=<<FONT FACE="Times New Roman" POINT-SIZE="20">a<SUB>t</SUB><SUP>exe</SUP></FONT><BR/><FONT POINT-SIZE="12">Robot command</FONT>>];
  obs:s -> vla:n;
  vla:s -> chunk:n;
  chunk -> action_encoder [color="#527caa"];
  force -> force_encoder [color="#b38251"];
  mlp -> residual;
  residual -> add;
  add -> output;

  {rank=same; obs; vla; chunk; force;}
  chunk -> force [style=invis];
  chunk:n -> add:n [constraint=false, minlen=5, color="#527caa", penwidth=1.8, xlabel=<<FONT FACE="Times New Roman" POINT-SIZE="17">a<SUB>t</SUB></FONT>>];
}
